# Una única fuente para el dominio canónico. No es la URL del servidor QA.
PUBLIC_SITE_URL=
# Sustituir por el origen HTTPS público real de la API al desplegar.
VITE_API_BASE_URL=
# Optional full public storage URL, including /storage. Independent of API/auth.
# Empty uses VITE_API_BASE_URL/storage; without either value uses /storage.
VITE_PUBLIC_STORAGE_URL=
