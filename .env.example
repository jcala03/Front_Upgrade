# Una única fuente para el dominio canónico. No es la URL del servidor QA.
PUBLIC_SITE_URL=
# Sustituir por el origen HTTPS público real de la API al desplegar.
VITE_API_BASE_URL=
# Optional full public storage URL, including /storage. Independent of API/auth.
# Empty uses VITE_API_BASE_URL/storage; without either value uses /storage.
VITE_PUBLIC_STORAGE_URL=
# Optional GA4. These gates default to off; never use an invented Measurement ID.
VITE_PRIVACY_CONTROLS_ENABLED=false
VITE_GA4_ENABLED=false
VITE_GA4_MEASUREMENT_ID=
VITE_GA4_SETTINGS_REVIEWED=false
VITE_ANALYTICS_INFORMATION_REVIEWED=false
# Explicit localhost-only developer testing, never enabled in a production build.
VITE_GA4_LOCAL_DEBUG=false
